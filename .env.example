PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Usa TRUST_PROXY=true cuando publiques detras de un proxy HTTPS como Render, Railway, Nginx o similar.
TRUST_PROXY=false
# Usa SESSION_STORE=file para persistir sesiones localmente; en NODE_ENV=production se activa por defecto.
SESSION_STORE=memory
SESSION_FILE_DIR=.sessions
SESSION_SECRET=cambia-esta-clave-local
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Usa el modo de Apps Script + Google Sheets o el modo JSON local.
CATALOG_STORAGE=modo_apps_script
CATALOG_JSON_PATH=productos.json
ORDERS_JSON_PATH=pedidos.json
INVENTORY_JSON_PATH=inventario-cuentas.json
RENEWALS_JSON_PATH=renovaciones.json
PROVIDERS_JSON_PATH=proveedores.json
PROVIDER_PURCHASES_JSON_PATH=compras-proveedor.json
AUDIT_LOG_JSON_PATH=auditoria.json
MESSAGE_TEMPLATES_JSON_PATH=plantillas-mensajes.json
USERS_JSON_PATH=usuarios-admin.json

# Configuracion recomendada para Google Apps Script.
APPS_SCRIPT_CATALOG_URL=https://script.google.com/macros/s/TU_DEPLOY_ID/exec
APPS_SCRIPT_ADMIN_TOKEN=copia-aqui-el-token-admin
APPS_SCRIPT_PROOF_DRIVE_FOLDER_ID=copia-aqui-el-id-de-la-carpeta-drive-para-comprobantes
APPS_SCRIPT_TIMEOUT_MS=15000

# Tamano maximo por archivo de comprobante subido desde la tienda.
PROOF_UPLOAD_MAX_MB=8

# Configuracion heredada opcional para Google Sheets directo con cuenta de servicio.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Productos!A:J
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
